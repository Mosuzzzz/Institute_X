# Copy to .env at the project root for docker-compose.yml.
# This stack runs the backend in production mode and requires real Resend delivery.
# Replace all secret placeholders before starting services.
# Generate each password/signing secret separately with: openssl rand -hex 32
# Use URL-safe passwords: Compose embeds PostgreSQL and Redis passwords in URLs.
POSTGRES_DB=institute_x
POSTGRES_USER=institute_x
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433
# Optional least-privilege roles created by scripts/server/harden-production-data.sh.
DATABASE_APP_USER=institute_x_app
DATABASE_APP_PASSWORD=replace-with-a-separate-strong-password
DATABASE_MIGRATE_USER=institute_x_migrate
DATABASE_MIGRATE_PASSWORD=replace-with-a-separate-strong-password

REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379
# Allowed range: 15-300 seconds. Redis TLS and CA trust are configured by Compose.
AUTH_SESSION_CACHE_TTL_SECONDS=60
AUTH_CACHE_SIGNING_KEY=replace-with-at-least-32-random-characters

MINIO_ROOT_USER=institute_x
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_API_PORT=9000
# Application credentials should not be the MinIO root credentials.
S3_ACCESS_KEY_ID=institute-x-app
S3_SECRET_ACCESS_KEY=replace-with-a-separate-strong-password
# Browser-reachable URL; use your host/domain when accessing from another machine.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=institute-x-private
S3_REGION=us-east-1
# Allowed range: 60-3600 seconds.
S3_SIGNED_URL_TTL_SECONDS=300

# Required: independent random secrets of at least 32 characters for OTP hashing
# and AUTH_CACHE_SIGNING_KEY above. The backend rejects their placeholder values.
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Compose sets OTP_EMAIL_PROVIDER=resend. Use a real API key and verified sender.
RESEND_API_KEY=re_replace-with-your-resend-api-key
OTP_FROM_EMAIL="Institute X <no-reply@example.com>"

# Public backend gateway port and permitted frontend origin.
HTTP_PORT=8080
CORS_ORIGIN=http://localhost:3001

# Optional offsite backups. When set, the server backup job uses restic.
# RESTIC_REPOSITORY=s3:https://backup-provider.example/bucket/institute-x
# RESTIC_PASSWORD=replace-with-a-separate-strong-password
# AWS_ACCESS_KEY_ID=replace-with-backup-provider-key
# AWS_SECRET_ACCESS_KEY=replace-with-backup-provider-secret
