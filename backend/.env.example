NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institute_x
CORS_ORIGIN=http://localhost:3001
REDIS_URL=redis://localhost:6379
AUTH_SESSION_CACHE_TTL_SECONDS=300
SSO_PROVIDER=mock
MOCK_SSO_ME_URL=https://mock-university-sso.vercel.app/api/sso/me
MOCK_SSO_VERIFY_URL=https://mock-university-sso.vercel.app/api/sso/verify
MOCK_SSO_ALLOWED_EMAIL_DOMAIN=university.ac.th
OIDC_USERINFO_URL=https://sso.institute.example/oidc/userinfo
OIDC_ALLOWED_EMAIL_DOMAIN=institute.example
OIDC_ROLE_CLAIM=role
OIDC_ACCOUNT_STATUS_CLAIM=account_status
OIDC_MAJOR_CODE_CLAIM=major_code
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=institute-x-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-this-secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
