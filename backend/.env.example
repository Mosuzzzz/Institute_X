NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institute_x
CORS_ORIGIN=http://localhost:3001
REDIS_URL=redis://localhost:6379
# Production must use rediss://. Every sensitive value can instead be mounted as a file,
# for example REDIS_URL_FILE=/run/secrets/redis_url and AUTH_CACHE_SIGNING_KEY_FILE=...
AUTH_SESSION_CACHE_TTL_SECONDS=60
AUTH_CACHE_SIGNING_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_EXECUTIVE_EMAIL=executive@example.com
BOOTSTRAP_EXECUTIVE_USERNAME=executive
BOOTSTRAP_EXECUTIVE_NAME=System Executive
BOOTSTRAP_EXECUTIVE_PASSWORD=change-this-secure-password
BOOTSTRAP_REGISTRAR_EMAIL=registrar@example.com
BOOTSTRAP_REGISTRAR_USERNAME=registrar
BOOTSTRAP_REGISTRAR_NAME=System Registrar
BOOTSTRAP_REGISTRAR_PASSWORD=change-this-secure-password
S3_ENDPOINT=http://localhost:9000
# URL reachable by the user's browser. For LAN deployment, replace localhost with the host IP/domain.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=institute-x-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-this-secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
