# Copy to backend/.env for a backend running on the host machine.
# See docs/Email_OTP_Setup.md for Mailpit and real email setup.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Standalone local PostgreSQL. For the project's Docker Compose database, use
# localhost:5433 (or POSTGRES_PORT) and match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institute_x

# Required: replace this placeholder with a random secret of at least 32 characters.
# Generate each secret separately with: openssl rand -hex 32
# The application intentionally rejects the placeholder below.
OTP_HASH_SECRET=replace-with-at-least-32-random-characters

# Optional Redis session cache. Omit REDIS_URL to use PostgreSQL session validation.
# Production requires rediss://. Set REDIS_PASSWORD only if Redis requires it (min. 12 characters).
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=replace-with-your-redis-password
# Required when REDIS_URL is set; generate a separate random secret as described above.
AUTH_CACHE_SIGNING_KEY=replace-with-at-least-32-random-characters
# Allowed range: 15-300 seconds.
AUTH_SESSION_CACHE_TTL_SECONDS=60

# Local email capture: start docker-compose.mailpit.yml; inbox http://localhost:8025.
# A containerized backend needs a reachable Mailpit host instead of 127.0.0.1.
OTP_EMAIL_PROVIDER=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
OTP_FROM_EMAIL="Institute X <no-reply@x.ac.th>"
# Real delivery: set OTP_EMAIL_PROVIDER=resend, supply a real API key, and replace
# OTP_FROM_EMAIL with a verified sender. Production only supports Resend.
# RESEND_API_KEY=re_replace-with-your-resend-api-key

# Optional bootstrap script inputs; use verified accounts. Mock addresses are for development.
BOOTSTRAP_EXECUTIVE_EMAIL=executive@x.ac.th
BOOTSTRAP_REGISTRAR_EMAIL=registrar@x.ac.th

# Local S3-compatible storage. Match access credentials to your MinIO configuration
# (MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in Docker Compose) and create the bucket first.
S3_ENDPOINT=http://localhost:9000
# URL reachable by the user's browser. For LAN deployment, replace localhost with the host IP/domain.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=institute-x-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-this-secret
S3_FORCE_PATH_STYLE=true
# Allowed range: 60-3600 seconds.
S3_SIGNED_URL_TTL_SECONDS=300

# File-backed secrets: DATABASE_URL, REDIS_URL, AUTH_CACHE_SIGNING_KEY, OTP_HASH_SECRET,
# RESEND_API_KEY, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY support a _FILE suffix.
# Set either the value or its _FILE path, never both. Example (remove REDIS_URL above):
# REDIS_URL_FILE=/run/secrets/redis_url
