NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/institute_x
CORS_ORIGIN=http://localhost:3001
REDIS_URL=redis://localhost:6379
# Production must use rediss://. Every sensitive value can instead be mounted as a file,
# for example REDIS_URL_FILE=/run/secrets/redis_url and AUTH_CACHE_SIGNING_KEY_FILE=...
AUTH_SESSION_CACHE_TTL_SECONDS=60
# Development seed only; never use mock credentials in production.
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
OTP_EMAIL_PROVIDER=mailpit
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OTP_FROM_EMAIL=Institute X <no-reply@x.ac.th>
AUTH_CACHE_SIGNING_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_EXECUTIVE_EMAIL=executive@x.ac.th
BOOTSTRAP_REGISTRAR_EMAIL=registrar@x.ac.th
S3_ENDPOINT=http://localhost:9000
# URL reachable by the user's browser. For LAN deployment, replace localhost with the host IP/domain.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=institute-x-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-this-secret
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300
