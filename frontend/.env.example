# Copy to frontend/.env for local development.
# Server-only URL used by Next.js API routes; do not prefix with NEXT_PUBLIC_.
# Local backend: http://localhost:3000
# Docker Compose backend gateway: http://localhost:8080 (or the configured HTTP_PORT).
# A containerized frontend needs a backend address reachable from its container.
BACKEND_BASE_URL=http://localhost:3000
# OTP, database, Redis and storage credentials belong in backend/.env or the
# root Docker .env. NODE_ENV is managed by Next.js; do not set it here.
