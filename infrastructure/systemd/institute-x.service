[Unit]
Description=Institute X Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/institute-x
ExecStart=/usr/local/sbin/institute-x-start
ExecStop=/usr/bin/docker compose -p institute_x --env-file /etc/institute-x/production.env -f /srv/institute-x/current/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
