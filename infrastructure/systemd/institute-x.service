[Unit]
Description=Institute X Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/mosu/user/Project/Institute_X
ExecStart=/usr/bin/docker compose --env-file /etc/institute-x/production.env up -d
ExecStop=/usr/bin/docker compose --env-file /etc/institute-x/production.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
