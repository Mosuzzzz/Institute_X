[Unit]
Description=Institute X application and disk monitoring heartbeat
After=network-online.target nginx.service institute-x.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/sbin/institute-x-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
